          "name": "List extensions",
          "request": {
            "name": "List extensions",
            "description": {
              "content": "Returns a paginated list of VSCode/IDE extensions with risk assessment data. Supports search across name, description, and publisher.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "extensions"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "q",
                  "value": "<string>",
                  "description": "Search query — matches name, description, and publisher"
                },
                {
                  "disabled": false,
                  "key": "sort",
                  "value": "recent",
                  "description": "Sort field"
                },
                {
                  "disabled": false,
                  "key": "dir",
                  "value": "<string>",
                  "description": "Sort direction"
                },
                {
                  "disabled": false,
                  "key": "status",
                  "value": "<string>",
                  "description": "Filter by risk status"
                },
                {
                  "disabled": false,
                  "key": "marketplace",
                  "value": "<string>",
                  "description": "Filter by marketplace (e.g. 'vscode', 'open-vsx')"
                },
                {
                  "disabled": false,
                  "key": "hash",
                  "value": "<string>",
                  "description": "Filter by SHA-256 hash (64 hex characters) of the archived extension VSIX bytes. Returns extensions whose fileSha256 matches. Note: extensions don't currently have a multi-version dedup wrapper, so this matches any row whose hash equals the input. Composes with q, status, and marketplace."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "Page number"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "50",
                  "description": "Results per page (1–200)"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
